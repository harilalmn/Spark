<Project>

  <!--
    Canonical build settings for every project in this repository.

    Version is NOT set here. It comes from MinVer, derived from the nearest git tag
    (see ADR-0007 and AGENTS.md). Spark uses SemVer rather than calendar versioning
    because Spark.Api and Spark.Geometry are published contract packages: the version
    number has to communicate breakage, which a date cannot do.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!--
      Implicit usings are OFF deliberately. Spark.Geometry is a library people script
      against in code blocks, and an explicit using list is part of how they learn the
      namespace layout. It also stops a global using from silently colliding with a
      user type. Same reasoning CADScript used.
    -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!--
      Project-wide policy inherited from DoodleSharp: no unsafe code. Span<T>,
      ref struct and System.Numerics cover everything the kernel needs. Revisit only
      with a benchmark that shows a real cost, never on taste.
    -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Warnings are errors in CI only, never locally. A red build on a stray unused
      variable mid-edit trains people to pass -warnaserror:false, which defeats the
      gate entirely. CI passes -warnaserror; local dev stays pleasant.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!--
      Nothing in this repository is published to nuget.org. Spark CONSUMES NuGet
      packages so that a user can bring any .NET library into a graph and get nodes
      from it; it does not publish its own. Embedders and node authors reference the
      assemblies from an install, which is how CAD add-ins are built anyway.
    -->
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>

    <Authors>Nicety</Authors>
    <Company>Nicety</Company>
    <Product>Spark</Product>
    <Copyright>Copyright (c) Nicety</Copyright>
    <RepositoryUrl>https://github.com/harilalmn/Spark</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    CS1591 (missing XML comment on a publicly visible member) is an ERROR on the four
    projects listed below. Undocumented public API does not build. This is the mechanism
    that makes the documentation standing instruction real rather than aspirational —
    see ADR-0015. Do not suppress it; write the comment.

    The four are exactly the surfaces a user or a package author writes against:
    Spark.Api is the node-authoring contract, Spark.Geometry and Spark.Geometry.Io are
    the kernel a code block scripts against, and Spark.Nodes.Core's XML comments become
    the tooltips on every built-in node. Spark.Engine is deliberately NOT on this list:
    it is published for embedders, but its surface is consumed by code rather than
    read by people, so the same standard would be cost without the benefit.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Spark.Api'
                         Or '$(MSBuildProjectName)' == 'Spark.Geometry'
                         Or '$(MSBuildProjectName)' == 'Spark.Geometry.Io'
                         Or '$(MSBuildProjectName)' == 'Spark.Nodes.Core'">
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    Public API baselines on the contract projects. Every addition or change to a public
    surface becomes a line in PublicAPI.Unshipped.txt, which makes it a reviewed diff
    rather than something noticed later.

    Since Spark publishes nothing to nuget.org (see ADR-0019), this is change control
    rather than a compatibility guarantee - but the geometry kernel is what every other
    kernel type is built on, so churn there is expensive regardless of who consumes it.
    It also feeds the docs-freshness CI job, which keys on these files.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Spark.Api'
                     Or '$(MSBuildProjectName)' == 'Spark.Geometry'
                     Or '$(MSBuildProjectName)' == 'Spark.Geometry.Io'
                     Or '$(MSBuildProjectName)' == 'Spark.Nodes.Core'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

</Project>
