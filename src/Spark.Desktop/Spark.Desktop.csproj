<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Spark.Desktop</RootNamespace>

    <!--
      The mark on the executable itself (`E8-T32`), which is what a task bar, a shortcut and
      Explorer show - a different thing from `Window.Icon`, which is what the window's own title
      bar shows, and both were asked for. The .ico is generated from the same SVG as the PNG by
      `scripts/make-logo.py`, so the two cannot drift.
    -->
    <ApplicationIcon>..\Spark.UI\Assets\spark-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spark.UI\Spark.UI.csproj" />

    <!--
      ADR-0020: the OpenCascade provider ships in the default install. FR-81 forbids a Dynamo
      user finding booleans greyed out on first run, so the application - not any library -
      takes the reference and installs it at startup.
    -->
    <ProjectReference Include="..\Spark.Geometry.Occt\Spark.Geometry.Occt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>
</Project>
