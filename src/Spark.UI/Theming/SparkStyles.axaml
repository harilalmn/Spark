<!--
  The hand-written half of the theme: the controls the shell actually uses.

  The one rule that shapes every selector below is §5.1 — hover moves a surface AWAY from the
  colour of the text on it. Spark's surfaces are dark and carry light text, so hover DARKENS
  them and press darkens them further. Contrast rises at every step; it never falls. A pull
  request that reverses one of these is rejected on that ground alone.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SparkBackgroundVoidBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SparkTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI Variable Text, Segoe UI, Noto Sans, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SparkTextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.primary">
    <Setter Property="Foreground" Value="{DynamicResource SparkTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource SparkTextMutedBrush}" />
  </Style>

  <!--
    A library row for a node this build's kernel cannot run (E2-T28). Disabled removes DEPTH, not
    CONTRAST - the same rule the toolbar's disabled state follows, section 4: the text drops to the
    disabled token, which is still above 4.5:1, and nothing is faded with opacity. A row at 40%
    alpha would be unreadable rather than unavailable, and the reason it is unavailable is the one
    sentence on the row somebody most needs to read.
  -->
  <Style Selector="Border.unavailable TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SparkTextDisabledBrush}" />
  </Style>

  <Style Selector="TextBlock.unavailable">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <!--
    The warning triangle before a warning message - the client's rule, 2026-09-11, for every banner
    and pane that warns. One class, so each draws the same glyph at the same size in the same amber
    and the next banner gets it by writing `Classes="warning"` rather than by drawing its own. 16 px
    sits on the first line of 13 px text; a one-line banner centres it instead.
  -->
  <Style Selector="PathIcon.warning">
    <Setter Property="Data" Value="{DynamicResource SparkWarningGlyph}" />
    <Setter Property="Foreground" Value="{DynamicResource SparkStateWarningBrush}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1,8,0" />
  </Style>

  <!-- Caption: 11 px is the floor. Nothing in Spark is set smaller, at any scale, in any state. -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource SparkTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.paneTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource SparkTextMutedBrush}" />
    <Setter Property="Margin" Value="10,8,10,6" />
  </Style>

  <!-- Panels sit on surface.base with a hairline divider. A hairline is decorative and is never
       a control boundary; border.control exists for that. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkBorderHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.chrome">
    <Setter Property="Background" Value="{DynamicResource SparkBackgroundVoidBrush}" />
  </Style>

  <!--
    E2 raised buttons. The shadow and the 1 px lit lip are the neumorphism; the label is what
    identifies the control, so a labelled button carries no border (§4.6).
  -->
  <Style Selector="Button.toolbar">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SparkTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkLipRestBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkLipRestBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- 12.30:1 -> 13.55:1. Darker, not lighter. -->
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkLipHoverBrush}" />
  </Style>

  <!-- 13.55:1 -> 14.95:1, and the lip is dropped because a pressed control is inset, not raised. -->
  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkBorderHairlineBrush}" />
  </Style>

  <!-- Disabled removes DEPTH, not contrast: flat fill, no lip, no hover, text still above 4.5:1. -->
  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SparkTextDisabledBrush}" />
  </Style>

  <!-- The active workspace carries a 2 px accent bottom bar as well as the raised fill, because
       colour is never the only carrier of meaning. -->
  <Style Selector="Button.toolbar.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!--
    E12-T21. The update badge: the one control in the ribbon that is allowed to shout.

    It is an accent FILL rather than accent text, and it is the only filled-accent control in the
    shell - which is the whole reason it reads as new information among twenty-six commands that
    all look alike on purpose. Dark text on the accent, not light: accent is a pale violet, so the
    legible pairing is bg.void over it rather than text.primary.

    Colour is not the only carrier (section 4.6 again): the label itself says what it is, so a
    reader who cannot distinguish the fill still reads "Update available".
  -->
  <Style Selector="Button.update">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource SparkBackgroundVoidBrush}" />
    <Setter Property="Background" Value="{DynamicResource SparkAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Button.update /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Button.update:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkAccentHoverBrush}" />
  </Style>

  <Style Selector="Button.update:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkAccentPressBrush}" />
  </Style>

  <!-- Splitters are dock gutters and sit on bg.void, which carries no elevation of its own. -->
  <!--
    surface.float is the elevation this design language reserves for menus, popups, dialogs,
    tooltips and autocomplete (section 4). The creation box is an autocomplete popup, so it uses
    the token rather than a new one, and it carries a border because it floats over a canvas whose
    background is only 1.2:1 away from it.
  -->
  <Style Selector="Border.float">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceFloatBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SparkBorderControlBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
  </Style>

  <!--
    The library's overloaded-member row, and the variants inside its popup (E5-T4). Both are
    buttons because both are clicked; neither LOOKS like a button, because a chrome-carrying
    control inside a tree row would read as a control sitting on a list rather than as the list
    itself. So: no fill, no border, no radius at rest, and the hover state is the whole of the
    affordance. The row is a ToggleButton because the popup it opens is bound to its checked
    state.

    The hover fill is the raised surface the toolbar uses, which is DARKER than the panel behind
    it, per section 4 - this design language moves down for emphasis, not up.
  -->
  <Style Selector="ToggleButton.overloads, Button.overload">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource SparkTextPrimaryBrush}" />
  </Style>

  <Style Selector="ToggleButton.overloads /template/ ContentPresenter#PART_ContentPresenter,
                   Button.overload /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ToggleButton.overloads:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.overload:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedHoverBrush}" />
  </Style>

  <Style Selector="ToggleButton.overloads:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   Button.overload:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SparkSurfaceRaisedPressedBrush}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource SparkBackgroundVoidBrush}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource SparkBorderStrongBrush}" />
  </Style>

</Styles>
