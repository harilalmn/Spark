<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             x:Class="Spark.UI.App"
             RequestedThemeVariant="Dark">

  <!--
    Spark v1 ships a dark theme only, and the variant is pinned rather than following the
    operating system. A neumorphic system is the worst possible candidate for a naive colour
    inversion — see design-language.md §2.7 for what a light theme would actually cost — so
    following the OS would produce a broken light theme rather than no light theme.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Spark.UI/Theming/SparkTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!--
      Dock's control templates. Without this a DockControl has no template and renders nothing at
      all - not an error, just an empty window, which is why the package is a reference rather
      than only a version pin. It goes above SparkStyles so the shell's own styles win.
    -->
    <dock:DockFluentTheme />

    <!--
      AvaloniaEdit's control templates, and the comment above applies word for word: without this
      a TextEditor has no template and renders nothing at all - not an error, just an empty area
      where the code block's source should be.

      It went unnoticed because every test of the editor drives the control directly, and a
      templateless control still holds a document, still reports its text and still raises its
      events. What it does not do is appear. Somebody adding a code block in the running
      application found a properties pane with a port row and a blank space below it.
    -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <StyleInclude Source="avares://Spark.UI/Theming/SparkStyles.axaml" />
  </Application.Styles>

</Application>
