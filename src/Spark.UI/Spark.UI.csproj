<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Spark's Avalonia controls and view models: the graph canvas, node library, editor host, docking and help.</Description>

    <!--
      Compiled bindings on by default, so a binding error is a compile error rather than a silent
      blank in the UI. Every view sets x:DataType; a view that does not fails to build.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Spark mark (`E8-T32`). AvaloniaResource rather than Content, so it is embedded in the
      assembly and reachable as `/Assets/spark-logo.png` from XAML - a loose file beside the
      executable would be one more thing a publish, a single-file bundle or an embedder could
      lose, and a window with no icon is how you find out.
    -->
    <AvaloniaResource Include="Assets/*.png" />

    <ProjectReference Include="..\Spark.Host\Spark.Host.csproj" />
    <ProjectReference Include="..\Spark.Viewport\Spark.Viewport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
