<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:controls="using:Spark.UI.Views.Controls"
             x:Class="Spark.UI.Views.Controls.CodeBlockEditor"
             x:DataType="controls:CodeBlockEditor"
             x:CompileBindings="False"
             ClipToBounds="True">

  <!--
    The completion list is a Border on a Canvas over the editor, not a Popup.

    A Popup is the obvious choice and it can extend past the pane's edge, which is worth having in
    a narrow inspector. It is not worth what it costs here: a Popup needs a window overlay layer,
    which the headless session used by every test in this project does not provide, so every
    assertion about placement, filtering and key handling would have to be made against a running
    application by hand. An in-tree overlay is testable, and the list is clipped to the pane rather
    than to the screen - a trade this project makes the same way everywhere else.
  -->
  <Panel>
    <ae:TextEditor Name="Editor"
                   FontFamily="Cascadia Code,Consolas,monospace"
                   FontSize="12"
                   ShowLineNumbers="True"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto">
      <!--
        VS Code's Selection menu, on the editor rather than in the main menu bar (`E6-T24`).

        Spark's own Edit menu is about nodes - group, collapse, align - and a Selection menu beside
        it would be greyed out or, worse, silently inert whenever the focus was anywhere but a code
        block. A context menu on the editor is where these commands are true, and it is also the
        only place their gestures are discoverable: eight of the fourteen do something no other
        part of the application can do.
      -->
      <ae:TextEditor.ContextMenu>
        <ContextMenu Name="SelectionMenu">
          <MenuItem Header="Select _All" InputGesture="Ctrl+A" Tag="SelectAll" Click="OnSelectionMenu" />
          <MenuItem Header="_Expand Selection" InputGesture="Shift+Alt+Right" Tag="ExpandSelection" Click="OnSelectionMenu" />
          <MenuItem Header="_Shrink Selection" InputGesture="Shift+Alt+Left" Tag="ShrinkSelection" Click="OnSelectionMenu" />
          <Separator />
          <MenuItem Header="Copy Line _Up" InputGesture="Shift+Alt+Up" Tag="CopyLineUp" Click="OnSelectionMenu" />
          <MenuItem Header="Copy Line _Down" InputGesture="Shift+Alt+Down" Tag="CopyLineDown" Click="OnSelectionMenu" />
          <MenuItem Header="_Move Line Up" InputGesture="Alt+Up" Tag="MoveLinesUp" Click="OnSelectionMenu" />
          <MenuItem Header="Mo_ve Line Down" InputGesture="Alt+Down" Tag="MoveLinesDown" Click="OnSelectionMenu" />
          <MenuItem Header="Duplicate Selection" InputGesture="Ctrl+Shift+D" Tag="DuplicateSelection" Click="OnSelectionMenu" />
          <Separator />
          <MenuItem Header="Add Cursor Abo_ve" InputGesture="Ctrl+Alt+Up" Tag="AddCaretAbove" Click="OnSelectionMenu" />
          <MenuItem Header="Add Cursor _Below" InputGesture="Ctrl+Alt+Down" Tag="AddCaretBelow" Click="OnSelectionMenu" />
          <MenuItem Header="Add Cursors to Line Ends" InputGesture="Shift+Alt+I" Tag="AddCaretsToLineEnds" Click="OnSelectionMenu" />
          <MenuItem Header="Add _Next Occurrence" InputGesture="Ctrl+D" Tag="AddNextOccurrence" Click="OnSelectionMenu" />
          <MenuItem Header="Add _Previous Occurrence" Tag="AddPreviousOccurrence" Click="OnSelectionMenu" />
          <MenuItem Header="Select All _Occurrences" InputGesture="Ctrl+Shift+L" Tag="SelectAllOccurrences" Click="OnSelectionMenu" />
          <Separator />
          <MenuItem Name="ControlClickItem"
                    Header="Switch to Ctrl+Click for Multi-Cursor"
                    ToggleType="CheckBox"
                    Tag="ControlClick"
                    Click="OnSelectionMenu" />
          <MenuItem Name="ColumnSelectionItem"
                    Header="Column Selection Mode"
                    ToggleType="CheckBox"
                    Tag="ColumnSelection"
                    Click="OnSelectionMenu" />
        </ContextMenu>
      </ae:TextEditor.ContextMenu>
    </ae:TextEditor>

    <Canvas Name="CompletionLayer" IsHitTestVisible="False">
      <!--
        Signature help sits *above* the caret's line and the completion list below it, so that a
        call being typed with the list open is described and completed at once without either
        covering the other.
      -->
      <Border Name="SignatureFrame"
              IsVisible="False"
              Background="{DynamicResource ThemeBackgroundBrush}"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}"
              BorderThickness="1"
              CornerRadius="2"
              Padding="6,3"
              MaxWidth="560">
        <!--
          A DockPanel rather than a horizontal StackPanel, so that the signature wraps. A stack
          measures its children with infinite width, which means TextWrapping never takes effect
          and a long signature runs off a pane that clips it.
        -->
        <DockPanel LastChildFill="True">
          <TextBlock Name="SignatureOverloads"
                     DockPanel.Dock="Left"
                     Margin="0,0,8,0"
                     Opacity="0.55"
                     FontSize="10"
                     VerticalAlignment="Center" />
          <TextBlock Name="SignatureText"
                     FontFamily="Cascadia Code,Consolas,monospace"
                     FontSize="12"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border Name="CompletionFrame"
              IsVisible="False"
              Background="{DynamicResource ThemeBackgroundBrush}"
              BorderBrush="{DynamicResource ThemeBorderMidBrush}"
              BorderThickness="1"
              CornerRadius="2"
              MaxHeight="220"
              MinWidth="180">
        <ListBox Name="CompletionList"
                 SelectionMode="Single"
                 Background="Transparent"
                 BorderThickness="0">
          <!--
            A COLOURED LETTER BADGE, WHICH IS RCS'S AND IS BETTER THAN THE WORD IT REPLACES.

            This column used to hold the kind spelled out - `Class`, `Delegate`, `ExtensionMethod`
            - at 56 px minimum width, so more than a third of a narrow list was a word repeated
            down every row and the names it was there to qualify started a third of the way in.
            A 16 px badge says the same thing in the space of one character, and colour makes the
            grouping readable without being read: methods are purple, types orange, values blue.
          -->
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="16"
                        Height="16"
                        CornerRadius="3"
                        Background="{Binding GlyphBrush}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Glyph}"
                             Foreground="White"
                             FontSize="10"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Canvas>
  </Panel>
</UserControl>
