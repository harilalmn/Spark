<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Spark.UI.Controls"
        xmlns:vm="clr-namespace:Spark.UI.ViewModels"
        x:Class="Spark.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Spark"
        Width="1480"
        Height="900"
        MinWidth="720"
        MinHeight="480">

  <!--
    Undo is on the window rather than on the canvas because it is a document operation, not a
    canvas gesture: a literal typed in the properties pane is as undoable as a wire drawn on the
    canvas, and a binding on the canvas would only reach the second. Ctrl+Y and Ctrl+Shift+Z both
    redo, because users arrive from editors that disagree about which one it is.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <!--
    The shell is a Grid with splitters rather than a DockControl. Dock.Avalonia is referenced and
    is the intended home for this layout, but its control templates ship in a separate package
    (Dock.Avalonia.Themes.Fluent) that is not in Directory.Packages.props, and without them a
    DockControl has no template and renders nothing. The serialisable layout model this grid is
    driven from — Shell/WorkspaceLayout.cs, with reset and named presets — is the part that has
    to exist either way, and it carries over unchanged when the theme package lands.
  -->

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Toolbar. E2 chips on bg.void; the active workspace carries an accent bottom bar as well
         as a pressed fill, because colour is never the only carrier of meaning. -->
    <Border Grid.Row="0" Classes="chrome" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="SPARK" Classes="caption" VerticalAlignment="Center" Margin="4,0,12,0" />

        <Button Classes="toolbar" Content="Default"
                Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Default" />
        <Button Classes="toolbar" Content="Modelling"
                Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Modelling" />
        <Button Classes="toolbar" Content="Authoring"
                Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Authoring" />
        <Button Classes="toolbar" Content="Presenting"
                Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Presenting" />

        <Border Width="1" Margin="6,2" Background="{DynamicResource SparkBorderHairlineBrush}" />

        <Button Classes="toolbar" Content="Reset layout" Command="{Binding ResetLayoutCommand}" />
        <Button Classes="toolbar" Content="Zoom to fit" Click="OnZoomToFit" />
        <Button Classes="toolbar" Content="Frame viewport" Click="OnFrameViewport" />
        <Button Classes="toolbar" Content="2000 nodes" Click="OnLoadSynthetic" />
        <Button Classes="toolbar" Content="Open…" Click="OnOpenGraph" />
        <Button Classes="toolbar" Content="Save as…" Click="OnSaveGraph" />

        <Border Width="1" Margin="6,2" Background="{DynamicResource SparkBorderHairlineBrush}" />

        <!-- The tooltip names the step, so a user can see what Ctrl+Z is about to reverse before
             pressing it rather than after. -->
        <Button Classes="toolbar" Content="Undo" Command="{Binding UndoCommand}"
                ToolTip.Tip="{Binding UndoDescription}" />
        <Button Classes="toolbar" Content="Redo" Command="{Binding RedoCommand}"
                ToolTip.Tip="{Binding RedoDescription}" />
        <Button Classes="toolbar" Content="Demo graph" Click="OnLoadDemo" />
        <Button Classes="toolbar" Content="Curves" Click="OnLoadCurves" />
        <Button Classes="toolbar" Content="Run" Click="OnRun" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,4,*,4,320" x:Name="ShellColumns">

      <!-- Library. Select an entry and press Place, or double-click it. -->
      <Border Grid.Column="0" Classes="pane" x:Name="LibraryPane">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Classes="paneTitle" Text="LIBRARY" />

          <TextBox Grid.Row="1" Margin="10,0,10,8" Text="{Binding LibrarySearch, Mode=TwoWay}" />

          <ListBox Grid.Row="2" Margin="6,0,6,6"
                   x:Name="LibraryList"
                   ItemsSource="{Binding LibraryEntries}"
                   SelectedItem="{Binding SelectedLibraryEntry, Mode=TwoWay}"
                   DoubleTapped="OnLibraryDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryEntryViewModel">
                <StackPanel Spacing="1" ToolTip.Tip="{Binding Description}">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Classes="muted" FontSize="10" Text="{Binding Signature}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Button Grid.Row="3" Classes="toolbar" Margin="10,0,10,10"
                  HorizontalAlignment="Stretch" Content="Place node" Click="OnPlaceNode" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="*,4,*" x:Name="CentreRows">
        <Border Grid.Row="0" Classes="pane" Padding="1">
          <controls:GraphCanvas x:Name="Canvas" />
        </Border>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

        <Border Grid.Row="2" Classes="pane" Padding="1">
          <controls:ViewportControl x:Name="Viewport" />
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <Border Grid.Column="4" Classes="pane" x:Name="InspectorPane">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="paneTitle" Text="PROPERTIES" />

          <TextBlock Grid.Row="1" Margin="10,0,10,4" TextWrapping="Wrap"
                     Text="{Binding SelectionTitle}" />

          <TextBlock Grid.Row="2" Classes="muted" Margin="10,0,10,10" TextWrapping="Wrap"
                     Text="{Binding SelectionDescription}" />

          <!-- Editing a value here writes the literal through the engine graph, which marks the
               node and everything downstream dirty, and starts a run off the UI thread. -->
          <ItemsControl Grid.Row="3" Margin="10,0,10,10" ItemsSource="{Binding Inspector}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PortLiteralViewModel">
                <Grid ColumnDefinitions="90,*" Margin="0,0,0,6">
                  <!-- The type is on the row, not only in the tooltip. A box labelled "radius"
                       does not tell anybody what belongs in it, and a tooltip answers a question
                       the user has to have thought to ask. -->
                  <StackPanel Grid.Column="0" VerticalAlignment="Center"
                              ToolTip.Tip="{Binding Description}">
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Label}" />
                    <TextBlock Classes="muted" FontSize="10" Opacity="0.8" Text="{Binding TypeName}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" IsEnabled="{Binding IsEditable}"
                           Text="{Binding Text, Mode=TwoWay}"
                           LostFocus="OnLiteralCommitted"
                           KeyDown="OnLiteralKeyDown" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Grid.Row="4" Classes="paneTitle" Text="DIAGNOSTICS" />
          <TextBlock Grid.Row="5" Classes="muted" Margin="10,0,10,10" TextWrapping="Wrap"
                     Text="{Binding DiagnosticsText}" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="chrome" Padding="10,4">
      <TextBlock Classes="caption" Text="{Binding StatusText}" />
    </Border>
  </Grid>
</Window>
