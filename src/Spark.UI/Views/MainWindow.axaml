<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:vm="clr-namespace:Spark.UI.ViewModels"
        x:Class="Spark.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Spark"
        Icon="/Assets/spark-logo.png"
        Width="1480"
        Height="900"
        MinWidth="720"
        MinHeight="480">

  <!--
    Undo is on the window rather than on the canvas because it is a document operation, not a
    canvas gesture: a literal typed in the properties pane is as undoable as a wire drawn on the
    canvas, and a binding on the canvas would only reach the second. Ctrl+Y and Ctrl+Shift+Z both
    redo, because users arrive from editors that disagree about which one it is.
  -->
  <!--
    E12-T13. Undo and redo were the only gestures with a key of their own; opening, saving and
    running a graph - the three things a user does most - were reachable by mouse alone. The rest
    of the menu is reachable by Alt, and F1, Escape and Delete are handled in OnKeyDown.

    These are Window-level so they work wherever focus is, EXCEPT inside a text box that wants the
    key itself - which is why nothing here uses a bare letter.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <!--
    The shell is a real DockControl: the panes can be dragged into each other, floated out and
    put back. Its layout is built in C# rather than declared here (Shell/SparkDockFactory.cs),
    for two reasons. A Tool's Content is a template (N34), so declaring the panes inline would
    put them in a namescope this window cannot reach; and the arrangement has to be derivable
    from WorkspaceLayout, which is the serialisable half - presets, reset - and is much easier
    to keep honest when one function owns the mapping.
  -->

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <!--
      E8-T32: the ribbon.

      THE TOOLBAR WAS TWENTY-SIX BUTTONS ACROSS TWO WRAPPED ROWS, and the client asked for all of
      them in a menu bar. A wrapping toolbar was the right fix for the problem it had - controls
      falling off the right edge with no indication they existed - but it is the wrong shape for
      twenty-six things: everything is equally prominent, which is the same as nothing being
      prominent, and two rows of chrome is two rows the canvas does not get.

      What stays out here is what a graph author does over and over: run it, and choose when it
      runs. Everything else moved into the menu below. The logo is on the left because a window
      with no mark on it is a window nobody can find in a task bar - and because the same file is
      the window icon, so the two can never disagree.
    -->
    <Border Grid.Row="0" Classes="chrome" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="/Assets/spark-logo.png" Width="22" Height="22"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="SPARK" Classes="caption" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                   Margin="16,0" TextTrimming="CharacterEllipsis"
                   Text="{Binding SelectionTitle}" />

        <!--
          E3-T13: Manual, Automatic and Periodic, as Dynamo has them. Automatic is what the shell
          did unconditionally before this - every literal, every wire and every slider re-ran the
          graph - which is right for the first hour and wrong the moment one node takes four
          seconds. The dropdown is beside the Run button rather than buried in the menu because the
          two are one decision: a user who has just been made to wait is looking at Run.
        -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="muted" VerticalAlignment="Center" Text="Run" />
          <ComboBox Width="120" FontSize="11" MinHeight="0"
                    AutomationProperties.Name="When the graph runs"
                    ToolTip.Tip="Automatic runs after every edit. Manual runs only when you press Run. Periodic runs once a second."
                    ItemsSource="{Binding RunModeChoices}"
                    SelectedItem="{Binding SelectedRunMode, Mode=TwoWay}" />
          <Button Classes="toolbar" Content="Run" AutomationProperties.Name="Run the graph"
                  ToolTip.Tip="Run the graph (F5)" Click="OnRun" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
      The menu bar. Six headings, and every one of the toolbar's twenty-six buttons is under one of
      them. Grouped by what a user is doing rather than by which pane implements it: the demo
      graphs are under File because opening one replaces the document, and Freeze is under Graph
      rather than Edit because it changes what runs rather than what the document says.
    -->
    <Border Grid.Row="1" Classes="chrome" Padding="4,0">
      <Menu>
        <MenuItem Header="_File">
          <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="OnOpenGraph" />
          <MenuItem Header="_Save as…" InputGesture="Ctrl+S" Click="OnSaveGraph" />
          <Separator />
          <MenuItem Header="Open _demo graph" Click="OnLoadDemo" />
          <MenuItem Header="Open _curves example" Click="OnLoadCurves" />
          <MenuItem Header="Open s_urfaces example" Click="OnLoadSurfaces" />
          <MenuItem Header="Open so_lids example" Click="OnLoadSolids" />
          <Separator />
          <MenuItem Header="_Packages…" Click="OnOpenPackages" />
          <Separator />
          <MenuItem Header="E_xit" Click="OnExit" />
        </MenuItem>

        <MenuItem Header="_Edit">
          <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}"
                    ToolTip.Tip="{Binding UndoDescription}" />
          <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}"
                    ToolTip.Tip="{Binding RedoDescription}" />
          <Separator />
          <MenuItem Header="_Group selection" Click="OnGroupSelection" x:Name="GroupButton" />
          <MenuItem Header="_Collapse to node" Click="OnCollapseSelection" x:Name="CollapseButton"
                    ToolTip.Tip="Replace the selected nodes with one custom node" />
          <Separator />

          <!--
            One submenu rather than eight items on the bar. Aligning is occasional and its eight
            forms are a family. The whole submenu disables below two selected nodes, and the two
            distribute items disable below three, so nothing here is ever offered and then ignored.
          -->
          <MenuItem Header="_Align" x:Name="AlignButton">
            <MenuItem Header="Align left" Click="OnAlign" Tag="Left" />
            <MenuItem Header="Align centres" Click="OnAlign" Tag="HorizontalCentres" />
            <MenuItem Header="Align right" Click="OnAlign" Tag="Right" />
            <Separator />
            <MenuItem Header="Align top" Click="OnAlign" Tag="Top" />
            <MenuItem Header="Align middles" Click="OnAlign" Tag="VerticalCentres" />
            <MenuItem Header="Align bottom" Click="OnAlign" Tag="Bottom" />
            <Separator />
            <MenuItem Header="Distribute horizontally" Click="OnAlign"
                      Tag="DistributeHorizontally" x:Name="DistributeHorizontally" />
            <MenuItem Header="Distribute vertically" Click="OnAlign"
                      Tag="DistributeVertically" x:Name="DistributeVertically" />
          </MenuItem>
        </MenuItem>

        <MenuItem Header="_Insert">
          <MenuItem Header="_Code block" Click="OnAddCodeBlock"
                    ToolTip.Tip="Or double-click empty canvas" />
          <MenuItem Header="_Note" Click="OnAddNote" />
          <Separator />
          <MenuItem Header="_Two thousand synthetic nodes" Click="OnLoadSynthetic"
                    ToolTip.Tip="Replaces the graph. The canvas benchmark's own workload (ADR-0013)" />
        </MenuItem>

        <MenuItem Header="_View">
          <MenuItem Header="_Zoom canvas to fit" Click="OnZoomToFit" />
          <MenuItem Header="_Frame viewport" Click="OnFrameViewport" />
          <Separator />
          <MenuItem Header="_Workspace">
            <MenuItem Header="Default" Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Default" />
            <MenuItem Header="Modelling" Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Modelling" />
            <MenuItem Header="Authoring" Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Authoring" />
            <MenuItem Header="Presenting" Command="{Binding ApplyWorkspaceCommand}" CommandParameter="Presenting" />
          </MenuItem>
          <MenuItem Header="_Reset layout" Command="{Binding ResetLayoutCommand}" />
        </MenuItem>

        <MenuItem Header="_Graph">
          <MenuItem Header="_Run" InputGesture="F5" Click="OnRun" />
          <Separator />
          <MenuItem Header="Run _mode">
            <MenuItem Header="Automatic" Click="OnSetRunMode" Tag="Automatic" />
            <MenuItem Header="Manual" Click="OnSetRunMode" Tag="Manual" />
            <MenuItem Header="Periodic" Click="OnSetRunMode" Tag="Periodic" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_Freeze selection" Click="OnFreezeSelection" x:Name="FreezeButton"
                    ToolTip.Tip="Skip the selected nodes when the graph runs" />
        </MenuItem>

        <MenuItem Header="_Help">
          <MenuItem Header="_Help for the selected node" InputGesture="F1" Click="OnOpenHelp" />
          <Separator />
          <MenuItem Header="_About Spark" Click="OnOpenAbout" />
        </MenuItem>
      </Menu>
    </Border>

    <!--
      The missing-package banner (E7-T6). Collapsed unless a graph was opened that names a package
      this machine does not have. It sits between the menu and the workspace rather than inside the
      diagnostics pane because the pane can be hidden, and this is the one message a user needs
      before they start wondering why their graph does nothing.
    -->
    <Border Grid.Row="2" x:Name="MissingBanner" IsVisible="False"
            Background="{DynamicResource SparkSurfaceRaisedBrush}" Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="toolbar" Content="Dismiss" AutomationProperties.Name="Dismiss this message" Click="OnDismissMissing" />
        <Button DockPanel.Dock="Right" Classes="toolbar" x:Name="MissingInstallButton"
                Content="Find it" Click="OnInstallMissing" Margin="0,0,8,0"
                AutomationProperties.Name="Find the missing package" />
        <TextBlock x:Name="MissingBannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource SparkTextPrimaryBrush}" />
      </DockPanel>
    </Border>

    <dock:DockControl Grid.Row="3" x:Name="Shell" />

    <Border Grid.Row="4" Classes="chrome" Padding="10,4">
      <TextBlock Classes="caption" Text="{Binding StatusText}" />
    </Border>
  </Grid>
</Window>
