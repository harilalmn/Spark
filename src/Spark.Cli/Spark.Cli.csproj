<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>spark</AssemblyName>
    <RootNamespace>Spark.Cli</RootNamespace>
    <Description>The Spark command line: run, check, render, export and inspect graphs headlessly. Ships beside the desktop application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- `Program` is internal, and `spark check`'s contract is an exit code. -->
    <InternalsVisibleTo Include="Spark.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spark.Host\Spark.Host.csproj" />

    <!--
      ADR-0020: the OpenCascade provider ships in the default install, because a Dynamo user who
      finds booleans greyed out on first run is what FR-81 forbids. An *application* references
      it; no library does.
    -->
    <ProjectReference Include="..\Spark.Geometry.Occt\Spark.Geometry.Occt.csproj" />

    <!--
      `spark render` (E12-T5) draws through the software rasteriser, which lives here. Referencing
      the viewport from the command line costs no window and no graphics device: `Spark.Viewport`
      is Avalonia-free by design, and the GL backend inside it is never constructed unless
      something asks for it. What this buys is the one property the verb exists for - the same
      graph gives the same bytes on an agent with no display and no driver (E9-T5, E9-T12).
    -->
    <ProjectReference Include="..\Spark.Viewport\Spark.Viewport.csproj" />
  </ItemGroup>
</Project>
