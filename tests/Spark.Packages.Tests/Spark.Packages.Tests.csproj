<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The package layer's testable half, which is nearly all of it. Assembly load contexts, type
    identity across contexts and collectible unloading are all ordinary managed behaviour and
    need no network, no NuGet feed and no installed package: what they need is a real assembly
    on disk, and the build has produced several.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/Spark.Packages/Spark.Packages.csproj" />
    <ProjectReference Include="../../src/Spark.Viewport/Spark.Viewport.csproj" />

    <!--
      A real node library to package up. The manager tests install a .nupkg carrying
      Spark.Nodes.Core.dll and assert its hundred-odd nodes arrive - which a hand-made stub would
      not prove, and which is also what exercises the contract rule: Spark.Nodes.Core references
      Spark.Api and Spark.Geometry, so the package must get the host's copies of those.
    -->
    <ProjectReference Include="../../src/Spark.Nodes.Core/Spark.Nodes.Core.csproj" />
  </ItemGroup>

  <!--
    E5-T11. THE ONE ASSEMBLY IN THIS SOLUTION NOBODY HERE WROTE.

    `ExcludeAssets="all"` means this is not a reference: nothing compiles against MathNet, nothing
    copies it to an output folder, and the reference graph is unchanged. What it does is put the
    package on disk during restore, and `GeneratePathProperty` hands the test its location.

    RESTORED RATHER THAN DOWNLOADED, AND THAT IS THE WHOLE DESIGN OF THIS FIXTURE. A test that
    fetches from nuget.org goes red when nuget.org is slow, which is a result about the internet
    and not about Spark - `NuGetFeedTests` handles that by asserting nothing when the feed is
    unreachable, which is right for a feed probe and useless for an acceptance test. Restore has
    already happened by the time a test runs, it is cached on CI, and a missing package fails the
    build rather than skipping a check.
  -->
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MathNetPackageRoot</_Parameter1>
      <_Parameter2>$(PkgMathNet_Numerics)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
