<Project>

  <!--
    Central Package Management. Every version is pinned exactly, with no floating
    ranges anywhere.

    The reason is a lesson already paid for in CADScript: a package's own BCL
    dependencies are what break you, not the package. A Roslyn bump moved
    System.Collections.Immutable to a version the host runtime would not bind, and it
    failed only at run time, on the first real script. Pinning makes that a deliberate,
    reviewed change instead of a surprise on someone else's machine.

    Before adding or bumping ANY package, check what it drags in transitively.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build and versioning">
    <PackageVersion Include="MinVer" Version="[7.0.0]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup Label="Geometry">
    <!--
      Clipper2's C# distribution is pure managed and Boost-licensed (MIT-compatible).
      It is the ONLY third-party dependency of Spark.Geometry, and it stays isolated
      behind a single internal file exactly as C2VGeometry already isolates it, so the
      "no native dependencies" promise stays checkable. A CI job asserts no native
      binaries appear in Spark.Geometry's published output.
    -->
    <PackageVersion Include="Clipper2" Version="[2.0.0]" />
  </ItemGroup>

  <ItemGroup Label="Scripting (Roslyn)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[5.9.0]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="[5.9.0]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[5.9.0]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="[5.9.0]" />
  </ItemGroup>

  <ItemGroup Label="Packages (NuGet client)">
    <PackageVersion Include="NuGet.Protocol" Version="[7.9.0]" />
    <PackageVersion Include="NuGet.Packaging" Version="[7.9.0]" />
  </ItemGroup>

  <ItemGroup Label="UI (Avalonia)">
    <PackageVersion Include="Avalonia" Version="[12.1.1]" />
    <PackageVersion Include="Avalonia.Desktop" Version="[12.1.1]" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="[12.1.1]" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="[12.1.1]" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="[12.0.0]" />
    <PackageVersion Include="Dock.Avalonia" Version="[12.1.0.4]" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="[12.1.0.4]" />
    <!--
      Dock.Avalonia ships its control templates in this companion package. Without it a
      DockControl has no template and renders nothing at all - which is not an obvious
      failure, so it is referenced by Spark.UI rather than merely pinned here.
    -->
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="[12.1.0.4]" />
    <!--
      The XAML-declarable half of the dock model: ProportionalDock, ToolDock, Tool and a
      Factory that can be written in a .axaml file. Dock.Model.Mvvm is the same model built
      in C# instead, and the shell uses the XAML one because a Tool's Content is a template
      (N34) - which makes the panes inside it UserControls either way, but keeps the layout
      itself readable next to the window it lays out.
    -->
    <PackageVersion Include="Dock.Model.Avalonia" Version="[12.1.0.4]" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="[8.4.2]" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="[4.0.0]" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[4.0.0]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[18.9.0]" />
    <!--
      Used for HeadlessUnitTestSession only. Its [AvaloniaFact] attribute is compiled
      against xunit.v3 3.2.2 and calls TestIntrospectionHelper.GetTestCaseDetails with a
      signature that no longer exists in 4.0.0, so every such test fails at DISCOVERY
      with MissingMethodException rather than at run time. Headless UI tests therefore
      drive the session directly under a plain [Fact] and take no xunit coupling.
    -->
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="[12.1.1]" />
    <!-- Property-based testing on the kernel. Non-negotiable from M1 — see ADR-0018. -->
    <PackageVersion Include="CsCheck" Version="[4.8.0]" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="[0.15.8]" />
  </ItemGroup>

</Project>
