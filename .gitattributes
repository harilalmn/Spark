# eol=lf, not bare `text=auto`. Without it, git normalises to LF in the repository but
# converts to native on checkout - so the same blob is CRLF on Windows and LF on Linux,
# and a single `dotnet format` gate cannot pass on both. Caught by the ubuntu CI job on
# its first run, which is precisely what that job exists for.
* text=auto eol=lf

*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.md        text
*.json      text
*.yml       text

# Graph files are canonically-formatted JSON so they diff and merge in git.
# That is the whole reason .spark is not a zip container - see ADR-0017.
*.spark       text eol=lf
*.sparkcustom text eol=lf

*.sparkz   binary
*.sparkgeo binary
*.png      binary
*.ico      binary
