# Build output
bin/
obj/
artifacts/
publish/
*.binlog

# Test and coverage
TestResults/
coverage/
*.coverage
*.trx

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# OS
Thumbs.db
.DS_Store

# Logs
*.log

# Local-only settings. Committed settings live in .claude/settings.json.
.claude/settings.local.json

# Local NuGet package cache for graph-scoped packages
packages/

# BenchmarkDotNet writes its reports beside the working directory it was run from, which is
# usually the repository root. They are a measurement of one machine on one day, so they are
# output rather than a record - the numbers worth keeping go in docs/NOTES.md with their
# conditions stated, and the line they must not cross goes in bench/budgets.jsonc.
BenchmarkDotNet.Artifacts/

# What the nightly's canvas step captures, and what a local run of it leaves behind.
canvas.log

# Visual regression artefacts. The golden is committed; what a failing run writes beside it is not.
tests/corpus/viewport/*.actual.png
tests/corpus/viewport/*.diff.png
