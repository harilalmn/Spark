# Build output
bin/
obj/
artifacts/
publish/
*.binlog

# Test and coverage
TestResults/
coverage/
*.coverage
*.trx

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# OS
Thumbs.db
.DS_Store

# Logs
*.log

# Local-only settings. Committed settings live in .claude/settings.json.
.claude/settings.local.json

# Local NuGet package cache for graph-scoped packages
packages/

# BenchmarkDotNet writes its reports beside the working directory it was run from, which is
# usually the repository root. They are a measurement of one machine on one day, so they are
# output rather than a record - the numbers worth keeping go in docs/NOTES.md with their
# conditions stated, and the line they must not cross goes in bench/budgets.jsonc.
BenchmarkDotNet.Artifacts/

# What the nightly's canvas step captures, and what a local run of it leaves behind.
canvas.log

# Visual regression artefacts. The golden is committed; what a failing run writes beside it is not.
tests/corpus/viewport/*.actual.png
tests/corpus/viewport/*.diff.png

# The summary a failing geometry golden writes beside its golden, so the two can be diffed
# (E11-T11). The golden itself is committed; what a red run produced is not.
tests/corpus/geometry/*.actual.tsv

# The same, for the help-renderer goldens (E11-T7). Both are deleted by the run that goes
# green again, so one being present always means that fixture is red now - N177.
tests/corpus/help/*.actual.tsv

# Python's bytecode cache. scripts/ holds build-progress.py and assemble-changelog.py; importing
# either of them - which is how the register's summary counts are re-derived rather than adjusted -
# leaves a __pycache__ behind that has no business in the tree.
scripts/__pycache__/
